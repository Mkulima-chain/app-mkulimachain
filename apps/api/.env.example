# ===========================================================================
# API MkulimaChain — modèle de configuration
#
# Copiez ce fichier en `.env.local` (PAS `.env`) :
#   cp apps/api/.env.example apps/api/.env.local
#
# ⚠️  Le nom du fichier compte : apps/api/src/database/database.module.ts
#     charge explicitement `envFilePath: '.env.local'`. Un `.env` seul ne
#     serait lu que par TypeORM CLI (data-source.ts), pas par NestJS.
#
# Ce fichier n'est JAMAIS versionné ni synchronisé par la CI : il vit
# uniquement sur le serveur.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=5600

# Origines autorisées par CORS, séparées par des virgules.
# Si FRONTEND_URL est défini, il REMPLACE la liste par défaut du code
# (voir apps/api/src/main.ts) : indiquez donc tous les fronts.
FRONTEND_URL=https://mkulimachain.com,https://app.mkulimachain.com
WEB_URL=https://mkulimachain.com
ADMIN_URL=https://app.mkulimachain.com

# ---------------------------------------------------------------------------
# Base de données PostgreSQL
#
# En production, `synchronize` et `migrationsRun` sont désactivés
# (apps/api/src/config/database.config.ts) : le schéma n'évolue que via
# `pnpm --filter=api migration:run`, exécuté par scripts/deploy.sh.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=mkulimachain
DB_PASSWORD=change_me
DB_NAME=mkulimachain
DB_SSL=false

# ---------------------------------------------------------------------------
# JWT
# Générer chaque secret avec :  openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_me_too
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Google OAuth
# L'URL de callback doit être déclarée à l'identique dans la console Google Cloud.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.mkulimachain.com/api/auth/google/callback

# ---------------------------------------------------------------------------
# Cloudinary (photos de récoltes, avatars, visuels marketplace)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# IPFS / Pinata (métadonnées NFT CIP-25)
# ---------------------------------------------------------------------------
IPFS_PROJECT_ID=
IPFS_PROJECT_SECRET=
IPFS_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ---------------------------------------------------------------------------
# SMTP (courriels transactionnels)
# Avec Gmail, SMTP_PASS doit être un mot de passe d'application, pas le mot
# de passe du compte.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mkulimachain.com
