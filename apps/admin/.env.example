# ===========================================================================
# Admin MkulimaChain (Next.js) — modèle de configuration
#
#   cp apps/admin/.env.example apps/admin/.env.local
#
# ⚠️  NEXT_PUBLIC_* est figé dans le bundle au build et lisible publiquement.
#     Aucun secret ici. En production, les valeurs viennent de
#     scripts/deploy.sh et de la CI.
# ===========================================================================

NEXT_PUBLIC_API_URL=http://localhost:5600/api
NEXT_PUBLIC_SITE_URL=http://localhost:5602

# ---------------------------------------------------------------------------
# Cardano (opérations d'administration : validation de lots, mint de NFT)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CARDANO_NETWORK=preprod
NEXT_PUBLIC_BLOCKFROST_API_KEY=
NEXT_PUBLIC_PLATFORM_ADDRESS=
