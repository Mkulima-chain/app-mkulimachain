# ===========================================================================
# Web MkulimaChain (Next.js) — modèle de configuration
#
#   cp apps/web/.env.example apps/web/.env.local
#
# ⚠️  Toute variable NEXT_PUBLIC_* est FIGÉE DANS LE BUNDLE au moment du build
#     et devient publiquement lisible dans le navigateur. Ne jamais y mettre
#     de secret. Les valeurs de production sont fournies au build par
#     scripts/deploy.sh et .github/workflows/ci.yml — ce fichier sert au
#     développement local.
# ===========================================================================

# ---------------------------------------------------------------------------
# API
# En local : http://localhost:5600/api
# En production, la valeur est injectée au build : https://api.mkulimachain.com/api
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5600/api
NEXT_PUBLIC_SITE_URL=http://localhost:5601

# ---------------------------------------------------------------------------
# NextAuth
# NEXTAUTH_SECRET est un secret SERVEUR (pas de préfixe NEXT_PUBLIC_).
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:5601
NEXTAUTH_SECRET=change_me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Cardano
# CARDANO_NETWORK : preprod (test) ou mainnet (production).
# La clé Blockfrost doit correspondre au réseau choisi.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CARDANO_NETWORK=preprod
NEXT_PUBLIC_BLOCKFROST_API_KEY=
NEXT_PUBLIC_PLATFORM_ADDRESS=

# ---------------------------------------------------------------------------
# Contrats Plutus compilés (CBOR hex)
# Générés depuis contracts/ — voir apps/web/.env.contracts.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_AUTH_VALIDATOR_CODE=
NEXT_PUBLIC_ORDER_VALIDATOR_CODE=
NEXT_PUBLIC_LOAN_VALIDATOR_CODE=
NEXT_PUBLIC_ESCROW_VALIDATOR_CODE=
NEXT_PUBLIC_SALE_VALIDATOR_CODE=
NEXT_PUBLIC_MINTING_POLICY_CODE=
NEXT_PUBLIC_PLUTUS_SALE_VALIDATOR_CODE=
NEXT_PUBLIC_PLUTUS_MINTING_POLICY_CODE=
